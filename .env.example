# =============================================================================
# Arc DevKit — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env no git.
# =============================================================================
# Token do PyPI — necessário apenas para publicar o pacote no PyPI (CI/CD)
# Gere em: https://pypi.org/manage/account/token/
TOKEN_PYPI=pypi-...

# Chave da API Anthropic — obrigatória para o Dev Copilot e Tx Debugger
# Obtenha em: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# URL do nó RPC da Arc
# Testnet (desenvolvimento): https://arc-testnet.drpc.org
# Mainnet (produção, verão 2026): configurar quando disponível
ARC_RPC_URL=https://arc-testnet.drpc.org

# Chain ID da rede Arc
# Testnet: 5042002 (verifique na documentação oficial da Arc)
ARC_CHAIN_ID=5042002

# Chave privada da carteira — opcional
# Necessária apenas para operações que enviam transações (agentes, pagamentos)
# Formato: hex sem prefixo 0x
# ATENÇÃO: nunca use sua carteira principal aqui — crie uma carteira dedicada para testes
ARC_PRIVATE_KEY=

# Nível de log da aplicação
# Opções: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# Segurança (v0.4.7+)
# =============================================================================

# Ambiente de execução — em "production" a API exige API_KEY configurada,
# força HTTPS e envia o header Strict-Transport-Security
ENV=development

# Chave de autenticação da API REST (header X-API-Key)
# Obrigatória quando ENV=production
API_KEY=

# Teto de gas price em gwei — transações são rejeitadas acima deste valor
# Vazio = sem limite
MAX_GAS_PRICE_GWEI=

# =============================================================================
# Guardrails para agents autônomos (v0.4.7+)
# =============================================================================

# Limite de gasto diário (USDC) para ações autônomas (auto-recarga, triggers)
# Vazio = sem limite (NÃO recomendado em produção)
MAX_SPEND_PER_DAY_USDC=

# Whitelist de destinatários para transferências autônomas (separados por vírgula)
# Vazio = qualquer destino (NÃO recomendado em produção)
AGENT_ALLOWED_RECIPIENTS=
